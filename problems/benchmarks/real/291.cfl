digits = set(1...6)
combination = choose_replace_sequence(digits, 5)
not (next_to(2, 4) in combination)
not (next_to(1, 3) in combination)
not (next_to(3, 5) in combination)
not (next_to(1, 5) in combination)
not ((1, 1) in combination)
not ((2, 2) in combination)
not ((3, 3) in combination)
not ((4, 4) in combination)
not ((5, 5) in combination)
