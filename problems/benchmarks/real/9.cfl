set circle_decks = {circle0:9}
set square_decks = {square0:9}
set triangle_decks = {triangle0:9}
set red_decks = {circle0:3} + {square0:3} + {triangle0:3}
set blue_decks = {circle3:6} + {square3:6} + {triangle3:6}
set green_decks = {circle6:9} + {square6:9} + {triangle6:9}
set light_decks = {circle0, square0, triangle0} + {circle3, square3, triangle3} + {circle6, square6, triangle6}
set medium_decks = {circle1, square1, triangle1} + {circle4, square4, triangle4} + {circle7, square7, triangle7}
set dark_decks = {circle2, square2, triangle2} + {circle5, square5, triangle5} + {circle8, square8, triangle8}
set all_decks = circle_decks + square_decks + triangle_decks
set chosen_decks = choose(all_decks, 3)
|chosen_decks & circle_decks| = 1
|chosen_decks & square_decks| = 1
|chosen_decks & triangle_decks| = 1
|chosen_decks & red_decks| = 1
|chosen_decks & blue_decks| = 1
|chosen_decks & green_decks| = 1
|chosen_decks & light_decks| = 1
|chosen_decks & medium_decks| = 1
|chosen_decks & dark_decks| = 1
